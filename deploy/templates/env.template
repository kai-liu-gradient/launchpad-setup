# =============================================================================
# AniLaunchpad Production Environment (auto-generated)
# =============================================================================

# Core
NODE_ENV=production
PORT=6802
ADMIN_PORT=6804
LOG_LEVEL=info

# Database (6 schemas)
DATABASE_URL=${DATABASE_URL}
MONITORING_DATABASE_URL=${MONITORING_DATABASE_URL}
EVENTS_DATABASE_URL=${EVENTS_DATABASE_URL}
BILLING_DATABASE_URL=${BILLING_DATABASE_URL}
STATS_DATABASE_URL=${STATS_DATABASE_URL}
DB_CONNECTION_LIMIT=${DB_CONNECTION_LIMIT}

# Redis
USE_REDIS=true
REDIS_HOST=${REDIS_HOST}
REDIS_PORT=${REDIS_PORT}
REDIS_PASSWORD=${REDIS_PASSWORD}
REDIS_DB=0
MULTI_INSTANCE=true

# Security
JWT_SECRET=${JWT_SECRET}
JWT_REFRESH_SECRET=${JWT_REFRESH_SECRET}
SESSION_SECRET=${SESSION_SECRET}
ENCRYPTION_KEY=${ENCRYPTION_KEY}
CLAUDE_CREDENTIALS_ENCRYPTION_KEY=${CLAUDE_CREDENTIALS_ENCRYPTION_KEY}
SSH_KEY_ENCRYPTION_SECRET=${SSH_KEY_ENCRYPTION_SECRET}
ZT_PRIVATE_KEY="${ZT_PRIVATE_KEY}"

# Domain
EXTERNAL_DOMAIN=${EXTERNAL_DOMAIN}
PUBLIC_DOMAIN=${PUBLIC_DOMAIN}
PUBLIC_URL=${PUBLIC_URL}
EXTERNAL_API_URL=${EXTERNAL_API_URL}
INTERNAL_API_URL=${INTERNAL_API_URL}
INTERNAL_ADMIN_URL=${INTERNAL_ADMIN_URL}
CORS_ORIGINS=${CORS_ORIGINS}
INGRESS_DOMAIN=${INGRESS_DOMAIN}
BASE_DOMAIN=${BASE_DOMAIN}
DEFAULT_BACKEND=${DEFAULT_BACKEND}

# Kubernetes
KUBERNETES_ENABLED=true
STORAGE_CLASS=${STORAGE_CLASS}

# Gitea
GITEA_ROOT_URL=${GITEA_ROOT_URL}
GITEA_GIT_SSH=${GITEA_GIT_SSH}
GITEA_USER=gitea
# GITEA_ACCESS_TOKEN populated after bootstrap

# Router (internal)
ROUTER_LOCAL_URL=${ROUTER_LOCAL_URL}

# Gateway
ANI_CODE_GATEWAY_URL=${ANI_CODE_GATEWAY_URL}
ANI_CODE_GATEWAY_API_KEY=${ANI_CODE_GATEWAY_API_KEY}
ANI_CODE_GATEWAY_ENABLED=true
LAUNCHPAD_INTERNAL_SECRET=${LAUNCHPAD_INTERNAL_SECRET}
ANI_CODE_RELEASE_URL=${ANI_CODE_RELEASE_URL}

# Telegram Bot
TELEGRAM_BOT_USERNAME=${TELEGRAM_BOT_USERNAME}

# Email
EMAIL_FROM=${EMAIL_FROM}
LARK_SMTP_HOST=${SMTP_HOST}
LARK_SMTP_PORT=${SMTP_PORT}
LARK_SMTP_USER=${SMTP_USER}
LARK_SMTP_PASS=${SMTP_PASS}

# Stripe
STRIPE_MODE=test
STRIPE_SECRET_KEY=${STRIPE_SECRET_KEY}
STRIPE_PUBLISHABLE_KEY=${STRIPE_PUBLISHABLE_KEY}

# AI
CRS2_ENABLED=true
CRS2_API_URL=${CRS2_API_URL}
CRS2_API_KEY=${CRS2_API_KEY}

# Storage
STORAGE_PROVIDER=${STORAGE_PROVIDER}
AZURE_CONTAINER_SAS_URL=${AZURE_CONTAINER_SAS_URL}
S3_CHAT_ENDPOINT=${S3_ENDPOINT}
S3_CHAT_BUCKET=${S3_BUCKET}
AWS_ACCESS_KEY_ID=${S3_ACCESS_KEY}
AWS_SECRET_ACCESS_KEY=${S3_SECRET_KEY}

# Microsoft Entra ID
ENTRA_ENABLED=${ENTRA_ENABLED}
ENTRA_CLIENT_ID=${ENTRA_CLIENT_ID}
ENTRA_CLIENT_SECRET=${ENTRA_CLIENT_SECRET}
ENTRA_TENANT_ID=${ENTRA_TENANT_ID}
ENTRA_REDIRECT_URI=${ENTRA_REDIRECT_URI}

# Router config (shared .env)
ZT_PUBLIC_KEY="${ZT_PUBLIC_KEY}"

# Experimental
EXP_BOOTSTRAP_USE_BUN_RUNTIME=true
EXP_BOOTSTRAP_DEBUG=true
