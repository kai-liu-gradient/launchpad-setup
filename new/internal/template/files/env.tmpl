# =============================================================================
# AniLaunchpad Production Environment (auto-generated)
# =============================================================================

# Core
NODE_ENV=production
PORT=6802
ADMIN_PORT=6804
LOG_LEVEL=info

# Database (6 schemas)
DATABASE_URL={{ index .Derived.DBConnStrings "main" }}
MONITORING_DATABASE_URL={{ index .Derived.DBConnStrings "monitoring" }}
EVENTS_DATABASE_URL={{ index .Derived.DBConnStrings "events" }}
BILLING_DATABASE_URL={{ index .Derived.DBConnStrings "billing" }}
STATS_DATABASE_URL={{ index .Derived.DBConnStrings "stats" }}
DB_CONNECTION_LIMIT={{ .Config.Performance.DBConnLimit }}

# Redis
USE_REDIS=true
REDIS_HOST=redis
REDIS_PORT=6379
REDIS_PASSWORD={{ .Secrets.RedisPassword }}
REDIS_DB=0
MULTI_INSTANCE=true

# Security
JWT_SECRET={{ .Secrets.JWTSecret }}
JWT_REFRESH_SECRET={{ .Secrets.JWTRefreshSecret }}
SESSION_SECRET={{ .Secrets.SessionSecret }}
ENCRYPTION_KEY={{ .Secrets.EncryptionKey }}
CLAUDE_CREDENTIALS_ENCRYPTION_KEY={{ .Secrets.ClaudeCredentialsEncryptionKey }}
SSH_KEY_ENCRYPTION_SECRET={{ .Secrets.SSHKeyEncryptionSecret }}
ZT_PRIVATE_KEY={{ .Secrets.RSAPrivateKey }}

# Domain
EXTERNAL_DOMAIN={{ .Derived.DashboardURL }}
PUBLIC_DOMAIN={{ .Derived.LaunchpadDomain }}
PUBLIC_URL={{ .Derived.PublicURL }}
EXTERNAL_API_URL={{ .Derived.InternalAPIURL }}
INTERNAL_API_URL={{ .Derived.InternalAPIURL }}
INTERNAL_ADMIN_URL={{ .Derived.InternalAdminURL }}
CORS_ORIGINS={{ .Derived.CORSOrigins }}
INGRESS_DOMAIN={{ .Derived.IngressDomain }}
BASE_DOMAIN={{ .Config.Domain }}
DEFAULT_BACKEND={{ .Derived.DefaultBackend }}

# Kubernetes
KUBERNETES_ENABLED=true
STORAGE_CLASS={{ .Derived.StorageClass }}

# Gitea
GITEA_ROOT_URL={{ .Derived.GiteaURL }}
GITEA_GIT_SSH={{ .Derived.GiteaGitSSH }}
GITEA_USER=gitea
# GITEA_ACCESS_TOKEN populated after bootstrap

# Router (internal)
ROUTER_LOCAL_URL={{ .Derived.RouterLocalURL }}

# Gateway
ANI_CODE_GATEWAY_URL={{ .Derived.GatewayURL }}
ANI_CODE_GATEWAY_API_KEY={{ .Secrets.GatewayAPIKey }}
ANI_CODE_GATEWAY_ENABLED=true
LAUNCHPAD_INTERNAL_SECRET={{ .Secrets.InternalSecret }}
ANI_CODE_RELEASE_URL={{ .Derived.ANICodeReleaseURL }}

# Telegram Bot
TELEGRAM_BOT_USERNAME={{ .Config.Telegram.BotUsername }}

# Email
EMAIL_FROM={{ .Config.SMTP.From }}
LARK_SMTP_HOST={{ .Config.SMTP.Host }}
LARK_SMTP_PORT={{ .Config.SMTP.Port }}
LARK_SMTP_USER={{ .Config.SMTP.User }}
LARK_SMTP_PASS={{ .Config.SMTP.Password }}

# Stripe
STRIPE_MODE=test
STRIPE_SECRET_KEY={{ .Config.Stripe.SecretKey }}
STRIPE_PUBLISHABLE_KEY={{ .Config.Stripe.PublishableKey }}

# AI
CRS2_ENABLED=true
CRS2_API_URL={{ .Config.AI.CRS2Endpoint }}
CRS2_API_KEY={{ .Config.AI.CRS2Token }}

# Storage
STORAGE_PROVIDER={{ .Config.Storage.Mode }}
AZURE_CONTAINER_SAS_URL={{ .Config.Storage.AzureContainer }}
S3_CHAT_ENDPOINT=
S3_CHAT_BUCKET={{ .Config.Storage.S3Bucket }}
AWS_ACCESS_KEY_ID={{ .Config.Storage.S3Key }}
AWS_SECRET_ACCESS_KEY={{ .Config.Storage.S3Secret }}

# Microsoft Entra ID
ENTRA_ENABLED={{ if .Config.SSO.EntraClientID }}true{{ else }}false{{ end }}
ENTRA_CLIENT_ID={{ .Config.SSO.EntraClientID }}
ENTRA_CLIENT_SECRET={{ .Config.SSO.EntraSecret }}
ENTRA_TENANT_ID={{ .Config.SSO.EntraTenantID }}
ENTRA_REDIRECT_URI={{ .Derived.EntraRedirectURI }}

# Router config (shared .env)
ZT_PUBLIC_KEY={{ .Secrets.RSAPublicKey }}

# SSL
SSL_MODE={{ .Config.SSL.Mode }}
NODE_TLS_REJECT_UNAUTHORIZED={{ .Derived.NodeTLSReject }}

# Experimental
EXP_BOOTSTRAP_USE_BUN_RUNTIME=true
EXP_BOOTSTRAP_DEBUG=true
{{ if .Runtime.GiteaAccessToken }}
# Runtime values (generated during deployment)
GITEA_ACCESS_TOKEN={{ .Runtime.GiteaAccessToken }}
GITEA_USER={{ .Runtime.GiteaUser }}
{{ end }}
