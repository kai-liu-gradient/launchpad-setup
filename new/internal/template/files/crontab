# AniLaunchpad Cron Jobs
# Mount this file to /etc/crontabs/root in the cron container
#
# Usage:
#   volumes:
#     - ./pd/deploy/crontab:/etc/crontabs/root:ro
#
# Note: These match the systemd timers in the project root

# ==============================================================================
# BILLING
# ==============================================================================

# Billing cycle (every 5 minutes) - matches launchpad-billing-hourly.timer
*/5 * * * * cd /app && node scripts/cron-hourly-billing.js >> /var/log/cron/hourly-billing.log 2>&1

# Invoice generation (daily at 02:00) - matches launchpad-billing-monthly.timer
0 2 * * * cd /app && node scripts/cron-monthly-invoice.js >> /var/log/cron/monthly-invoice.log 2>&1

# Invoice finalization (daily at 02:30) - matches launchpad-invoice-finalize.timer
30 2 * * * cd /app && node scripts/cron-invoice-finalize.js >> /var/log/cron/invoice-finalize.log 2>&1

# ==============================================================================
# BACKUPS
# ==============================================================================

# Backup automation (hourly, random 0-5 min jitter to avoid overlap with billing/stats at :00)
# 0 * * * * sleep $((RANDOM \% 300)) && cd /app && node scripts/run-automated-backups.js >> /var/log/cron/backup-automation.log 2>&1
0 * * * *  cd /app && node scripts/run-automated-backups.js >> /var/log/cron/backup-automation.log 2>&1

# ==============================================================================
# STATS & EMAIL
# ==============================================================================

# Stats collection (every 10 minutes) - matches launchpad-stats-hourly.timer
*/10 * * * * cd /app && node scripts/cron-hourly-stats.js >> /var/log/cron/hourly-stats.log 2>&1

# Email queue processing (every minute) - matches launchpad-email-queue.timer (30s intervals)
* * * * * cd /app && node scripts/cron-email-queue.js >> /var/log/cron/email-queue.log 2>&1

# ==============================================================================
# LOG ROTATION (daily at 04:00)
# ==============================================================================
0 4 * * * find /var/log/cron -name "*.log" -size +10M -exec truncate -s 0 {} \;