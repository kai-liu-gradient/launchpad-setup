worker_processes auto;
error_log /var/log/nginx/error.log warn;
pid /var/run/nginx.pid;

events {
    worker_connections 1024;
    multi_accept on;
}

http {
    include /etc/nginx/mime.types;
    default_type application/octet-stream;

    log_format main '$remote_addr - $remote_user [$time_local] "$request" '
                    '$status $body_bytes_sent "$http_referer" '
                    '"$http_user_agent" upstream=$upstream_addr rt=$request_time';
    access_log /var/log/nginx/access.log main;

    sendfile on;
    tcp_nopush on;
    tcp_nodelay on;
    keepalive_timeout 65;
    types_hash_max_size 2048;
    client_max_body_size 100M;

    gzip on;
    gzip_vary on;
    gzip_proxied any;
    gzip_comp_level 6;
    gzip_types text/plain text/css text/xml application/json application/javascript
               application/rss+xml application/atom+xml image/svg+xml;

    # WebSocket upgrade map
    map $http_upgrade $connection_upgrade {
        default upgrade;
        ''      close;
    }

    # Rate limiting
    limit_req_zone $binary_remote_addr zone=api_limit:10m rate=100r/s;
    limit_req_zone $binary_remote_addr zone=admin_limit:10m rate=10r/s;

    # Upstreams
    upstream launchpad-api {
        least_conn;
        server api:6802 max_fails=3 fail_timeout=30s;
        keepalive 32;
    }

    upstream launchpad-admin {
        server api:6804;
        keepalive 8;
    }

    upstream launchpad-ui {
        server ui:6801;
        keepalive 8;
    }

    upstream launchpad-router {
        least_conn;
        server router:6580 max_fails=3 fail_timeout=30s;
        keepalive 16;
    }

    upstream launchpad-gateway {
        server gateway:6555;
        keepalive 8;
    }

    upstream launchpad-gitea {
        server gitea:3000;
        keepalive 8;
    }

    # SSL shared settings
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_ciphers ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-RSA-AES256-GCM-SHA384;
    ssl_prefer_server_ciphers off;
    ssl_session_timeout 1d;
    ssl_session_cache shared:SSL:50m;
    ssl_session_tickets off;

    # =========================================================================
    # 1. Dashboard — {{ .Derived.LaunchpadDomain }}
    # =========================================================================
    server {
        listen 443 ssl;
        http2 on;
        server_name {{ .Derived.LaunchpadDomain }};

        ssl_certificate /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;

        add_header Strict-Transport-Security "max-age=63072000" always;
        add_header X-Frame-Options "SAMEORIGIN" always;
        add_header X-Content-Type-Options "nosniff" always;

        # Health check
        location /nginx-health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }

        # Terminal WebSocket
        location ^~ /api/v1/terminal/ {
            proxy_pass http://launchpad-api$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Authorization $http_authorization;
            proxy_set_header Cookie $http_cookie;
            proxy_connect_timeout 60s;
            proxy_send_timeout 3600s;
            proxy_read_timeout 3600s;
            proxy_next_upstream off;
        }

        # SSE — headless OAuth
        location ~ ^/api/v1/headless-oauth/.*/output$ {
            proxy_pass http://launchpad-api;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_cache off;
            chunked_transfer_encoding on;
            proxy_set_header Accept-Encoding "";
            proxy_connect_timeout 60s;
            proxy_read_timeout 660s;
            proxy_send_timeout 660s;
            proxy_next_upstream off;
        }

        # SSE — OAuth signup
        location ~ ^/api/v1/auth/oauth-signup/.*/output$ {
            proxy_pass http://launchpad-api;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Connection "";
            proxy_buffering off;
            proxy_cache off;
            chunked_transfer_encoding on;
            proxy_set_header Accept-Encoding "";
            proxy_connect_timeout 60s;
            proxy_read_timeout 660s;
            proxy_send_timeout 660s;
            proxy_next_upstream off;
        }

        # Socket.io WebSocket
        location ^~ /api/socket.io/ {
            proxy_pass http://launchpad-api$request_uri;
            proxy_http_version 1.1;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection "upgrade";
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_connect_timeout 60s;
            proxy_send_timeout 86400s;
            proxy_read_timeout 86400s;
            proxy_next_upstream off;
        }

        # Gateway proxy
        location = /gatewayproxy { return 301 /gatewayproxy/; }
        location ^~ /gatewayproxy/ {
            proxy_pass http://launchpad-gateway/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-Proto https;
            proxy_connect_timeout 60s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
            proxy_next_upstream error timeout http_500 http_502 http_503;
        }

        # API routes
        location /api/ {
            limit_req zone=api_limit burst=50 nodelay;
            proxy_pass http://launchpad-api/api/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Connection "";
            proxy_connect_timeout 60s;
            proxy_send_timeout 300s;
            proxy_read_timeout 300s;
        }

        # Admin dashboard
        location /admin/ {
            limit_req zone=admin_limit burst=20 nodelay;
            proxy_pass http://launchpad-admin/;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }

        # Frontend (default)
        location / {
            proxy_pass http://launchpad-ui;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
        }
    }

    # =========================================================================
    # 2. Gitea — {{ .Derived.GiteaDomain }}
    # =========================================================================
    server {
        listen 443 ssl;
        http2 on;
        server_name {{ .Derived.GiteaDomain }};

        ssl_certificate /etc/nginx/certs/fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/privkey.pem;

        add_header Strict-Transport-Security "max-age=63072000" always;

        location / {
            proxy_pass http://launchpad-gitea;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_connect_timeout 5s;
            proxy_read_timeout 180s;
            proxy_next_upstream error timeout http_500 http_502 http_503;
        }
    }

    # =========================================================================
    # 3. Project Wildcard — *.{{ .Config.Domain }}
    # =========================================================================
    server {
        listen 443 ssl;
        http2 on;
        server_name *.{{ .Config.Domain }};

        ssl_certificate /etc/nginx/certs/wildcard-fullchain.pem;
        ssl_certificate_key /etc/nginx/certs/wildcard-privkey.pem;

        add_header Strict-Transport-Security "max-age=63072000" always;
        add_header Content-Security-Policy "frame-ancestors 'self' https://{{ .Derived.LaunchpadDomain }}" always;
        add_header X-Content-Type-Options "nosniff" always;

        location / {
            proxy_pass http://launchpad-router;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto https;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_connect_timeout 60s;
            proxy_send_timeout 86400s;
            proxy_read_timeout 86400s;
        }
    }

    # =========================================================================
    # 4. Internal HTTP proxy (port 80) — Docker containers → ingress-nginx
    # =========================================================================
    server {
        listen 80;
        server_name *.{{ .Config.Domain }};

        location / {
            proxy_pass http://{{ .Derived.HostIP }}:30080;
            proxy_http_version 1.1;
            proxy_set_header Host $host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Upgrade $http_upgrade;
            proxy_set_header Connection $connection_upgrade;
            proxy_connect_timeout 60s;
            proxy_send_timeout 86400s;
            proxy_read_timeout 86400s;
        }
    }

    # =========================================================================
    # 5. HTTP → HTTPS redirect (all other domains)
    # =========================================================================
    server {
        listen 80 default_server;
        server_name _;

        location /nginx-health {
            access_log off;
            return 200 "healthy\n";
            add_header Content-Type text/plain;
        }

        location / {
            return 301 https://$host$request_uri;
        }
    }
}
